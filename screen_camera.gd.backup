extends Camera2D

## Metroidvania-style screen camera.
## Stays fixed on the current room (one full viewport). When the player leaves
## that room, the camera slides to the adjacent screen. Gameplay is paused for
## the duration of the slide so the player can't fall through the next room
## mid-transition (classic Super Metroid feel).

@export var transition_duration: float = 0.35
## Portion of the previous room kept visible while entering an adjacent room.
## This gives the cannon enough on-screen aiming room after a transition.
@export_range(0.0, 0.45, 0.05) var screen_overlap: float = 0.25

var screen_size: Vector2
var current_screen: Vector2i = Vector2i.ZERO
var is_transitioning: bool = false
var player: Node2D


func _ready() -> void:
	# Keep running while the tree is paused during a screen transition.
	process_mode = Node.PROCESS_MODE_ALWAYS
	screen_size = get_viewport_rect().size
	make_current()
	call_deferred("_init_on_player")


func _init_on_player() -> void:
	player = get_tree().get_first_node_in_group("player") as Node2D
	if player == null:
		return
	_snap_to_player_screen()


func _physics_process(_delta: float) -> void:
	if is_transitioning:
		return

	# Hold camera on the death scene while the burst plays.
	if player != null and is_instance_valid(player) \
			and player.get("is_dying") == true:
		return

	if player == null or not is_instance_valid(player):
		player = get_tree().get_first_node_in_group("player") as Node2D
		if player == null:
			return
		_snap_to_player_screen()
		return

	var exit_direction := _get_view_exit_direction(player.global_position)
	if exit_direction != Vector2i.ZERO:
		_transition_in_direction(exit_direction)


## After a soft respawn: pan (or snap) to the player's new screen.
func focus_on_player() -> void:
	if player == null or not is_instance_valid(player):
		player = get_tree().get_first_node_in_group("player") as Node2D
	if player == null:
		return

	var target_screen := _get_screen_for_position(player.global_position)
	if target_screen == current_screen:
		return

	await _transition_to_screen(target_screen)


func _get_screen_for_position(pos: Vector2) -> Vector2i:
	return Vector2i(
		floori(pos.x / screen_size.x),
		floori(pos.y / screen_size.y)
	)


func _screen_to_camera_center(screen: Vector2i) -> Vector2:
	# Default Camera2D anchor is the center of the view.
	return Vector2(
		screen.x * screen_size.x + screen_size.x * 0.5,
		screen.y * screen_size.y + screen_size.y * 0.5
	)


## Returns the direction in which the player has left the visible viewport.
## Unlike room-grid detection, this stays correct when adjacent rooms overlap.
func _get_view_exit_direction(pos: Vector2) -> Vector2i:
	var half_view := screen_size * 0.5
	if pos.x < global_position.x - half_view.x:
		return Vector2i.LEFT
	if pos.x > global_position.x + half_view.x:
		return Vector2i.RIGHT
	if pos.y < global_position.y - half_view.y:
		return Vector2i.UP
	if pos.y > global_position.y + half_view.y:
		return Vector2i.DOWN
	return Vector2i.ZERO


func _snap_to_player_screen() -> void:
	if player == null:
		return
	current_screen = _get_screen_for_position(player.global_position)
	global_position = _screen_to_camera_center(current_screen)


func _transition_to_screen(screen: Vector2i) -> void:
	if is_transitioning:
		return

	# Used for spawn/death focus, where centering on the destination room is best.
	current_screen = screen
	await _pan_to(_screen_to_camera_center(screen))


func _transition_in_direction(direction: Vector2i) -> void:
	if is_transitioning:
		return

	# Advance by only the non-overlapping part of a viewport. Once the player
	# reaches the visible edge, this places them screen_overlap into the next
	# view, leaving room to aim back toward the room they came from.
	current_screen = _get_screen_for_position(player.global_position)
	var distance := screen_size * (1.0 - screen_overlap)
	var target := global_position + Vector2(direction) * distance
	await _pan_to(target)


func _pan_to(target: Vector2) -> void:
	is_transitioning = true

	# Pause the whole scene (player, grappling physics, spikes, etc.)
	# while the camera pans. This node stays awake via PROCESS_MODE_ALWAYS.
	get_tree().paused = true
	if player != null and is_instance_valid(player):
		player.velocity = Vector2.ZERO
		player.momentum = Vector2.ZERO

	var tween := create_tween()
	tween.set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
	tween.set_trans(Tween.TRANS_SINE)
	tween.set_ease(Tween.EASE_IN_OUT)
	tween.tween_property(self, "global_position", target, transition_duration)
	await tween.finished

	global_position = target
	get_tree().paused = false
	is_transitioning = false

	# If the player is already outside the next view, continue panning.
	if player != null and is_instance_valid(player):
		var exit_direction := _get_view_exit_direction(player.global_position)
		if exit_direction != Vector2i.ZERO:
			await _transition_in_direction(exit_direction)
