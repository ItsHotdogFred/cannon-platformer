#!/bin/sh
# Intercepts pushes of real branches to GitHub and pushes placeholder-texture
# commits instead (see placeholder_push.py). Installed by install.sh.
#
# Bypass for a push you really want to contain real art (e.g. a private backup):
#   PLACEHOLDER_BYPASS=1 git push ...

remote="$1"
url="$2"

[ -n "$PLACEHOLDER_BYPASS" ] && exit 0
case "$url" in *github.com*) ;; *) exit 0 ;; esac

root=$(git rev-parse --show-toplevel)
script="$root/tools/placeholder_push/placeholder_push.py"
zero=0000000000000000000000000000000000000000
handled=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue          # branch deletion: let it through
    case "$local_ref" in
        refs/heads/*) branch=${local_ref#refs/heads/} ;;
        *) continue ;;
    esac
    python3 "$script" publish --branch "$branch" --remote "$remote" </dev/null || exit 1
    handled=1
done

if [ "$handled" = 1 ]; then
    echo
    echo ">>> Placeholder textures were pushed in place of your real art."
    echo ">>> Git will now report the original push as 'failed' - that is expected."
    exit 1
fi
exit 0
